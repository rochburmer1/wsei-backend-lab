@page
@model BackendLab01.Pages.List
@{
ViewData["Title"] = "Lista Quizów";
Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2>Lista Quizów</h2>

<ul>
    @foreach (var quiz in Model.Quizzes)
    {
    <li>
    <li><a asp-page="/Quiz/Item" asp-route-quizId="@quiz.Id" asp-route-itemId="1">@quiz.Title</a></li>
    </li>
    }
</ul>
